# Required by API and worker.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API server options.
PORT=3001
INTERNAL_ADMIN_ALLOWED_ORIGINS=http://localhost:3000

# Resend feedback endpoint auth (choose one when ingesting provider callbacks).
# RESEND_WEBHOOK_SECRET=whsec_replace_me
# RESEND_WEBHOOK_BEARER_TOKEN=replace_me

# Notification worker tuning.
NOTIFICATION_WORKER_BATCH_SIZE=25
NOTIFICATION_WORKER_POLL_INTERVAL_MS=5000
NOTIFICATION_WORKER_STALE_ATTEMPT_MINUTES=15
NOTIFICATION_PROVIDER_NAME=local-development-provider

# Provider credential resolution (pick one strategy).
# 1) JSON dictionary keyed by providerConfig.credentialRef.
# NOTIFICATION_PROVIDER_CREDENTIALS_JSON={"demo_resend":{"apiKey":"re_demo_key"}}
#
# 2) Individual env var per credential ref.
# If credentialRef is "demo_resend", use:
# NOTIFICATION_PROVIDER_CREDENTIAL_DEMO_RESEND={"apiKey":"re_demo_key"}

# Initial platform_admin bootstrap command options.
# INTERNAL_API_BOOTSTRAP_DESCRIPTION=Initial local bootstrap platform admin token
# INTERNAL_API_BOOTSTRAP_EXPIRES_AT=2026-12-31T23:59:59.000Z
